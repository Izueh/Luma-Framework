<?xml version="1.0" encoding="utf-8"?>
<!-- Build settings for game projects (the Luma dll). Import it right after "Luma2.Common.props". -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Every game is built as the system dll it replaces, in its own output folder so they don't overwrite each other -->
    <TargetName>$(LumaDllName)</TargetName>
    <OutDir>$(Luma2Root)Binaries\$(Configuration)\$(ProjectName)\</OutDir>
    <!-- Optional SDKs, opted into per game in its project's Globals -->
    <UseLumaDXP Condition="'$(UseLumaDXP)'==''">false</UseLumaDXP>
    <UseLumaNGX Condition="'$(UseLumaNGX)'==''">false</UseLumaNGX>
    <UseLumaFSR Condition="'$(UseLumaFSR)'==''">false</UseLumaFSR>
    <UseLumaFSR4 Condition="'$(UseLumaFSR4)'==''">false</UseLumaFSR4>
    <UseLumaXeSS Condition="'$(UseLumaXeSS)'==''">false</UseLumaXeSS>
    <UseLumaD3D12Interop Condition="'$(UseLumaD3D12Interop)'=='' and ('$(UseLumaFSR4)'=='true' or '$(UseLumaXeSS)'=='true')">true</UseLumaD3D12Interop>
    <UseLumaD3D12Interop Condition="'$(UseLumaD3D12Interop)'==''">false</UseLumaD3D12Interop>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseLumaNGX)'=='true'">
    <LumaNGXRoot>$(LumaExternalDir)NGX\</LumaNGXRoot>
    <LumaNGXLibName Condition="'$(LumaDebugConfiguration)'=='true'">nvsdk_ngx_d_dbg.lib</LumaNGXLibName>
    <LumaNGXLibName Condition="'$(LumaDebugConfiguration)'=='false'">nvsdk_ngx_d.lib</LumaNGXLibName>
    <LumaNGXRuntimePath Condition="'$(Configuration)'=='Development-Debug' or '$(Configuration)'=='Development-Release'">$(LumaNGXRoot)bin\dev\nvngx_dlss.dll</LumaNGXRuntimePath>
    <LumaNGXRuntimePath Condition="'$(Configuration)'!='Development-Debug' and '$(Configuration)'!='Development-Release'">$(LumaNGXRoot)bin\rel\nvngx_dlss.dll</LumaNGXRuntimePath>
    <ExternalIncludePath>$(LumaNGXRoot);$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseLumaFSR)'=='true' or '$(UseLumaFSR4)'=='true'">
    <LumaFSRRoot>$(LumaExternalDir)FidelityFX\</LumaFSRRoot>
    <LumaFSRLibSuffix Condition="'$(LumaDebugConfiguration)'=='true'">d</LumaFSRLibSuffix>
    <LumaFSRLibSuffix Condition="'$(LumaDebugConfiguration)'=='false'"></LumaFSRLibSuffix>
    <ExternalIncludePath>$(LumaFSRRoot);$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseLumaXeSS)'=='true'">
    <LumaXeSSRoot>$(LumaExternalDir)XeSS\</LumaXeSSRoot>
    <ExternalIncludePath>$(LumaXeSSRoot)inc;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>

  <!-- DXP (DirectXShaderPatcher), for shader patching recipes: 1.0's vcpkg port (Source/External/vcpkg-ports/dxp), through the game
       project's vcpkg.json and vcpkg-configuration.json -->
  <PropertyGroup Condition="'$(UseLumaDXP)'=='true'">
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(MSBuildProjectDirectory)</VcpkgManifestRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- The game's shaders, for the cbuffer structs Core and the game share with them ("Game/GameCBuffers.hlsl"): before Global's,
           as the game's files win a name clash at runtime -->
      <AdditionalIncludeDirectories>$(Luma2Root)Resources\$(ProjectName)\Shaders;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>LUMA_PROJECT_NAME="$(ProjectName)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(UseLumaDXP)'=='true'">
      <PreprocessorDefinitions>LUMA_USE_DXP=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(UseLumaNGX)'=='true'">
      <PreprocessorDefinitions>LUMA_USE_NGX=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(UseLumaFSR)'=='true'">
      <PreprocessorDefinitions>LUMA_USE_FSR=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(UseLumaFSR4)'=='true'">
      <PreprocessorDefinitions>LUMA_USE_FSR4=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(UseLumaXeSS)'=='true'">
      <PreprocessorDefinitions>LUMA_USE_XESS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(UseLumaD3D12Interop)'=='true'">
      <PreprocessorDefinitions>LUMA_USE_D3D12_INTEROP=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link Condition="'$(UseLumaDXP)'=='true'">
      <AdditionalDependencies>dxpatcher.lib;Ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Link Condition="'$(UseLumaNGX)'=='true'">
      <AdditionalLibraryDirectories>$(LumaNGXRoot)libs;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(LumaNGXLibName);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Link Condition="'$(UseLumaFSR)'=='true'">
      <AdditionalLibraryDirectories>$(LumaFSRRoot)libs;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ffx_backend_dx11_x64$(LumaFSRLibSuffix).lib;ffx_fsr3_x64$(LumaFSRLibSuffix).lib;ffx_frameinterpolation_x64$(LumaFSRLibSuffix).lib;ffx_fsr3upscaler_x64$(LumaFSRLibSuffix).lib;ffx_opticalflow_x64$(LumaFSRLibSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="LumaCopySrRuntimes" AfterTargets="Build" Condition="Exists('$(TargetDir)')">
    <PropertyGroup>
      <!-- Resolved inside the target so WindowsSdkDir / TargetPlatformVersion from Microsoft.Cpp.targets are populated -->
      <_LumaDxcDir Condition="'$(LumaDxcDir)'!=''">$(LumaDxcDir)</_LumaDxcDir>
      <_LumaDxcDir Condition="'$(_LumaDxcDir)'=='' and Exists('$(Luma2ExternalDir)DXC\dxcompiler.dll')">$(Luma2ExternalDir)DXC\</_LumaDxcDir>
      <_LumaDxcDir Condition="'$(_LumaDxcDir)'=='' and Exists('$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(PlatformTarget)\dxcompiler.dll')">$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(PlatformTarget)\</_LumaDxcDir>
    </PropertyGroup>
    <Copy Condition="'$(UseLumaNGX)'=='true' and Exists('$(LumaNGXRuntimePath)')" SourceFiles="$(LumaNGXRuntimePath)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(UseLumaFSR4)'=='true'">
      <_LumaFfxRuntimeFiles Include="$(LumaFSRRoot)bin\*.dll" />
    </ItemGroup>
    <Copy Condition="'$(UseLumaFSR4)'=='true'" SourceFiles="@(_LumaFfxRuntimeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(UseLumaXeSS)'=='true'" SourceFiles="$(LumaXeSSRoot)bin\libxess.dll;$(LumaXeSSRoot)bin\libxess_dx11.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <MakeDir Condition="'$(Platform)'=='x64' and '$(_LumaDxcDir)'!='' and Exists('$(_LumaDxcDir)dxcompiler.dll')" Directories="$(TargetDir)Luma" />
    <Copy Condition="'$(Platform)'=='x64' and '$(_LumaDxcDir)'!='' and Exists('$(_LumaDxcDir)dxcompiler.dll')" SourceFiles="$(_LumaDxcDir)dxcompiler.dll;$(_LumaDxcDir)dxil.dll" DestinationFolder="$(TargetDir)Luma\" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copies the dll and its pdb into the game when "LumaGameDir" is set (e.g. in the project's .vcxproj.user file), next to the "Luma" folder the mod reads and writes -->
  <Target Name="LumaDeploy" AfterTargets="LumaCopySrRuntimes" Condition="'$(LumaGameDir)'!=''">
    <PropertyGroup>
      <_LumaDxcDir Condition="'$(LumaDxcDir)'!=''">$(LumaDxcDir)</_LumaDxcDir>
      <_LumaDxcDir Condition="'$(_LumaDxcDir)'=='' and Exists('$(Luma2ExternalDir)DXC\dxcompiler.dll')">$(Luma2ExternalDir)DXC\</_LumaDxcDir>
      <_LumaDxcDir Condition="'$(_LumaDxcDir)'=='' and Exists('$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(PlatformTarget)\dxcompiler.dll')">$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(PlatformTarget)\</_LumaDxcDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath);$(OutDir)$(TargetName).pdb" DestinationFolder="$(LumaGameDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(UseLumaNGX)'=='true' and Exists('$(LumaNGXRuntimePath)')" SourceFiles="$(LumaNGXRuntimePath)" DestinationFolder="$(LumaGameDir)" SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(UseLumaFSR4)'=='true'">
      <_LumaFfxDeployFiles Include="$(LumaFSRRoot)bin\*.dll" />
    </ItemGroup>
    <Copy Condition="'$(UseLumaFSR4)'=='true'" SourceFiles="@(_LumaFfxDeployFiles)" DestinationFolder="$(LumaGameDir)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(UseLumaXeSS)'=='true'" SourceFiles="$(LumaXeSSRoot)bin\libxess.dll;$(LumaXeSSRoot)bin\libxess_dx11.dll" DestinationFolder="$(LumaGameDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(LumaGameDir)Luma" />
    <Copy Condition="'$(Platform)'=='x64' and '$(_LumaDxcDir)'!='' and Exists('$(_LumaDxcDir)dxcompiler.dll')" SourceFiles="$(_LumaDxcDir)dxcompiler.dll;$(_LumaDxcDir)dxil.dll" DestinationFolder="$(LumaGameDir)Luma\" SkipUnchangedFiles="true" />
    <!-- The Luma folder is Global's files with the game's on top (a game's file wins a name clash) -->
    <ItemGroup>
      <LumaGlobalResource Include="$(Luma2Root)Resources\Global\**\*" Exclude="$(Luma2Root)Resources\Global\**\.gitkeep" />
      <LumaGameResource Include="$(Luma2Root)Resources\$(ProjectName)\**\*" Exclude="$(Luma2Root)Resources\$(ProjectName)\**\.gitkeep" />
    </ItemGroup>
    <Copy SourceFiles="@(LumaGlobalResource)" DestinationFiles="@(LumaGlobalResource->'$(LumaGameDir)Luma\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LumaGameResource)" DestinationFiles="@(LumaGameResource->'$(LumaGameDir)Luma\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(LumaGameDir)" />
  </Target>
</Project>
