#!/bin/bash

# Checks the formatting of the staged Luma2 sources (Luma2/.clang-format), as the CI job does for all of them.
# clang-tidy isn't run: there's no compile database.

FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'Luma2/Source/*.c' 'Luma2/Source/*.cpp' 'Luma2/Source/*.h' 'Luma2/Source/*.hpp' 'Luma2/Templates/*.c' 'Luma2/Templates/*.cpp' 'Luma2/Templates/*.h' 'Luma2/Templates/*.hpp')

if [ -z "$FILES" ]; then
    exit 0
fi

FAILED=0
while IFS= read -r FILE; do
    # The staged content, not the working copy
    if ! git show ":$FILE" | clang-format --style=file --assume-filename="$FILE" --dry-run --Werror 2>&1; then
        echo "Formatting issues in: $FILE"
        FAILED=1
    fi
done <<< "$FILES"

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "Commit rejected: run clang-format -i --style=file on the files above"
    exit 1
fi

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File Scripts/Check-Luma2Rules.ps1 || exit 1
elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/Check-Luma2Rules.ps1 || exit 1
fi
exit 0
